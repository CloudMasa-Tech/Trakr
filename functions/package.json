{
  "name": "trakr-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for TRAKR tenant provisioning and superadmin management",
  "main": "lib/index.js",
  "scripts": {
    "prebuild": "node scripts/copy-assets.js",
    "build": "tsc",
    "postbuild": "node scripts/copy-assets.js",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && firebase deploy --only functions",
    "predeploy": "node scripts/check-deployment-freshness.js",
    "logs": "firebase functions:log",
    "lint": "eslint --ext .ts src/"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0"
  },
  "private": true
}

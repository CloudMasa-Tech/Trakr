rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ═══════════════════════════════════════════════════════════════════
    // TRAKR TENANT (DATA PLANE) FIRESTORE RULES
    // ═══════════════════════════════════════════════════════════════════
    // This ruleset is written for a single TENANT Firebase project — one of
    // the dedicated per-workspace projects created during provisioning. It is
    // intentionally GENERIC: it contains no project id, workspace id, company
    // id, API key or email, so the exact same file can be deployed to tenant A,
    // tenant B, tenant C, … via:
    //
    //   firebase deploy --only firestore:rules --project <tenant-project-id>
    //
    // Authorization model (mirrors the TRAKR app):
    //   * Every authenticated user has a `users/{uid}` document that carries
    //     `companyId` + the RBAC fields (role/roleId/roleName/roleLevel/
    //     permissionIds). That document is the single source of truth for
    //     role resolution (AuthSessionProvider reads `users/{uid}.role`).
    //   * There is NO platform Super Admin inside a tenant project. The top
    //     tenant authority is the Company Admin (roleId/role ==
    //     `company_admin`/`admin`).
    //   * `app_config/admin_access` is the bootstrap trust anchor seeded by
    //     the provisioning flow BEFORE the first `users/{uid}` doc. Its
    //     recorded `primaryAdminEmail` is the only account allowed to
    //     self-create a privileged `users/{uid}` doc (isSeededBootstrapAdmin)
    //     or to touch the anchor itself afterwards.
    //   * A self-registered account may create its own `users/{uid}` doc only
    //     WITHOUT any RBAC privilege field (noPrivilegeFields), and can never
    //     change those fields later (unchangedPrivileges) — so no signed-in
    //     user can promote themselves or anyone else.
    //   * `roles/*` carries the permission catalog; writes require the
    //     `roles.manage` permission and system roles are write-protected.
    // ═══════════════════════════════════════════════════════════════════

    function signedIn() {
      return request.auth != null;
    }

    // The caller's `companyId` from their own `users/{uid}` document. A
    // signed-in user without a users doc resolves to null and fails every
    // company-scoped rule, so unprovisioned accounts are effectively denied.
    function userCompanyId() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
          : null;
    }

    // True when the caller is the tenant's Company Admin. In a tenant project
    // this is the top administrative authority (there is no platform Super
    // Admin). Both the canonical `roleId` (`company_admin`/`admin`) and the
    // legacy `role` field (`admin`/`company_admin`) are honoured, matching how
    // the app resolves admin status from `users/{uid}`.
    function isCompanyAdmin() {
      let userData = exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
          : null;
      let roleId = userData != null ? userData.roleId : null;
      let role = userData != null ? userData.role : null;
      return (roleId != null && roleId in ['admin', 'company_admin'])
          || (role != null && role in ['admin', 'company_admin']);
    }

    // True when the caller belongs to the tenant's company (their users-doc
    // companyId equals the given company id).
    function inCompany(companyId) {
      return signedIn() && companyId != null && companyId == userCompanyId();
    }

    // True when the existing document belongs to the caller's company.
    function sameCompany() {
      return inCompany(resource.data.companyId);
    }

    // True when the incoming document belongs to the caller's company (used
    // for create).
    function sameCompanyOnCreate() {
      return inCompany(request.resource.data.companyId);
    }

    // True when the pending write does not change any RBAC field
    // (role/roleId/roleName/roleLevel/permissionIds). Self-service profile
    // updates may freely edit personal fields (name, email, phone, photo,
    // fcmToken …) but must never be able to escalate privileges by rewriting
    // their own role assignment or permission set.
    function unchangedPrivileges() {
      return (!('role' in request.resource.data)
              || request.resource.data.role == resource.data.role)
          && (!('roleId' in request.resource.data)
              || request.resource.data.roleId == resource.data.roleId)
          && (!('roleName' in request.resource.data)
              || request.resource.data.roleName == resource.data.roleName)
          && (!('roleLevel' in request.resource.data)
              || request.resource.data.roleLevel == resource.data.roleLevel)
          && (!('permissionIds' in request.resource.data)
              || request.resource.data.permissionIds == resource.data.permissionIds);
    }

    // True when the incoming write assigns NO RBAC privilege field at all
    // (role/roleId/roleName/roleLevel/permissionIds are all absent). Used by
    // the `users` create rule so a self-registered account can only carry a
    // doc without privileges — closing the self-promotion vector where a
    // signed-in user creates their own users/{uid} doc with a privileged
    // roleId and a full permission set.
    function noPrivilegeFields() {
      return !('role' in request.resource.data)
          && !('roleId' in request.resource.data)
          && !('roleName' in request.resource.data)
          && !('roleLevel' in request.resource.data)
          && !('permissionIds' in request.resource.data);
    }

    // True when the caller is the tenant's primary admin as recorded in
    // `app_config/admin_access` (seeded by provisioning BEFORE the first
    // users doc). This is the only non-admin path that may legitimately
    // self-create a users/{uid} document carrying privilege fields: it is the
    // tenant bootstrap itself. The admin_access doc is write-protected (only
    // the recorded primary admin can touch it), so a random signed-in user can
    // never claim this trust anchor.
    function isSeededBootstrapAdmin() {
      return signedIn()
          && 'email' in request.auth.token
          && request.auth.token.email != null
          && exists(/databases/$(database)/documents/app_config/admin_access)
          && get(/databases/$(database)/documents/app_config/admin_access).data.primaryAdminEmail is string
          && get(/databases/$(database)/documents/app_config/admin_access).data.primaryAdminEmail.lower() == request.auth.token.email.lower();
    }

    // True when the caller holds any of the given permission ids. Permission
    // resolution mirrors AccessControlService._getUserPermissionIds: direct
    // `permissionIds` on the caller's `users` doc are unioned with the
    // `permissionIds` of the `roles/{roleId}` they are assigned, so role
    // inheritance and the app's single RBAC source of truth never disagree.
    function hasAnyPermission(uid, permissionIds) {
      let direct = exists(/databases/$(database)/documents/users/$(uid))
          ? get(/databases/$(database)/documents/users/$(uid)).data.permissionIds
          : null;
      let roleId = exists(/databases/$(database)/documents/users/$(uid))
          ? get(/databases/$(database)/documents/users/$(uid)).data.roleId
          : null;
      let rolePerms = roleId is string && roleId.size() > 0 &&
          exists(/databases/$(database)/documents/roles/$(roleId))
          ? get(/databases/$(database)/documents/roles/$(roleId)).data.permissionIds
          : null;
      return signedIn() &&
          (direct is list && direct.hasAny(permissionIds) ||
           rolePerms is list && rolePerms.hasAny(permissionIds));
    }

    // ── White-label config (readable without auth for app startup branding) ─
    // The WhiteLabelProvider streams this at app launch, before any user signs in.
    match /settings/white_label {
      allow read: if true;
      allow write: if signedIn() && isCompanyAdmin();
    }
    match /settings/{document=**} {
      allow read, write: if signedIn();
    }

    // ── Role directory ─────────────────────────────────────────────────
    match /staff/{document=**} {
      allow read: if signedIn() || sameCompany();
      allow create: if sameCompanyOnCreate();
      allow update: if isCompanyAdmin() || (sameCompany() && unchangedPrivileges());
      allow delete: if isCompanyAdmin();
    }
    match /managers/{document=**} {
      allow read: if signedIn() || sameCompany();
      allow create: if isCompanyAdmin() || sameCompanyOnCreate();
      allow update: if isCompanyAdmin() || (sameCompany() && unchangedPrivileges());
      allow delete: if isCompanyAdmin();
    }
    match /admins/{document=**} {
      allow read: if signedIn() || sameCompany();
      allow create: if isCompanyAdmin();
      allow update: if isCompanyAdmin();
      allow delete: if isCompanyAdmin();
    }

    // ── users/{uid} ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth.uid != null && (request.auth.uid == userId || sameCompany());

      allow create: if request.auth.uid != null && (
          request.auth.uid == userId
          || isCompanyAdmin()
      ) && (
          isCompanyAdmin()
          || isSeededBootstrapAdmin()
          || noPrivilegeFields()
      ) && (
          !('role' in request.resource.data)
          || request.resource.data.role == null
          || request.resource.data.role != 'super_admin'
      );

      allow update: if request.auth.uid != null && (
          request.auth.uid == userId
          || isCompanyAdmin()
      ) && (
          isCompanyAdmin()
          || unchangedPrivileges()
      ) && (
          !('role' in request.resource.data)
          || request.resource.data.role == null
          || request.resource.data.role != 'super_admin'
      );

      allow delete: if isCompanyAdmin();
    }

    // Legacy collection (not written by the client) — readable/writable by any
    // signed-in tenant member to avoid breaking any existing access.
    match /employees/{document=**} {
      allow read, write: if signedIn();
    }

    // ── Company ───────────────────────────────────────────────────────
    match /companies/{companyId} {
      allow read, write: if inCompany(companyId);
    }
    // Permission catalog consumed by the UI for role editing. It is NOT used
    // for authorization (permission resolution reads `users`/`roles`), so any
    // signed-in tenant member may read it.
    match /permissions/{document=**} {
      allow read, write: if signedIn();
    }
    // Roles bundle permissions and are read by permission resolution, so any
    // signed-in tenant member can read them. Writes require the `roles.manage`
    // permission (the Company Admin always has it via the seeded
    // `company_admin` role), so a plain employee can never alter the catalog.
    // System roles (isSystem == true) can never be updated or deleted from the
    // client — they are protected.
    match /roles/{roleId} {
      allow read: if signedIn();
      allow create: if isCompanyAdmin() ||
          hasAnyPermission(request.auth.uid, ['roles.manage']);
      allow update: if (isCompanyAdmin() ||
          hasAnyPermission(request.auth.uid, ['roles.manage']))
          && !get(/databases/$(database)/documents/roles/$(roleId)).data.isSystem;
      allow delete: if (isCompanyAdmin() ||
          hasAnyPermission(request.auth.uid, ['roles.manage']))
          && !get(/databases/$(database)/documents/roles/$(roleId)).data.isSystem;
    }

    // ── Config (global/tenant-level) ───────────────────────────────────
    // app_config/admin_access is the tenant bootstrap trust anchor. The
    // provisioner seeds it with the Company Admin's email BEFORE creating the
    // first users doc, so the `users` create rule can verify (via
    // isSeededBootstrapAdmin) that a self-created privileged doc belongs to the
    // recorded tenant admin — the only legitimate non-admin path.
    match /app_config/admin_access {
      allow read: if signedIn();
      allow create: if signedIn()
          && !exists(/databases/$(database)/documents/app_config/admin_access)
          && 'email' in request.auth.token
          && request.auth.token.email != null
          && request.resource.data.primaryAdminEmail is string
          && request.resource.data.primaryAdminEmail.lower() == request.auth.token.email.lower();
      allow update: if signedIn()
          && 'email' in request.auth.token
          && request.auth.token.email != null
          && resource.data.primaryAdminEmail is string
          && resource.data.primaryAdminEmail.lower() == request.auth.token.email.lower();
      allow delete: if signedIn()
          && 'email' in request.auth.token
          && request.auth.token.email != null
          && resource.data.primaryAdminEmail is string
          && resource.data.primaryAdminEmail.lower() == request.auth.token.email.lower();
    }
    // Other app_config docs (e.g. `app_config/platform`, tenant white-label
    // config) — readable/writable by any signed-in tenant member. The trust
    // anchor doc `admin_access` is excluded here so it stays protected.
    match /app_config/{docId} {
      allow read, write: if signedIn() && docId != 'admin_access';
    }
    match /geo_config/{document=**} {
      allow read, write: if signedIn();
    }
    match /offices/{document=**} {
      allow read, write: if signedIn();
    }
    match /qr_tokens/{document=**} {
      allow read, write: if signedIn();
    }

    // Tenant-default catalogs seeded during workspace provisioning.
    match /departments/{document=**} {
      allow read, write: if signedIn();
    }
    match /designations/{document=**} {
      allow read, write: if signedIn();
    }
    match /leave_policies/{document=**} {
      allow read, write: if signedIn();
    }
    match /holidays/{document=**} {
      allow read, write: if signedIn();
    }

    // ── Attendance ────────────────────────────────────────────────────
    match /attendance/{document=**} {
      allow read: if sameCompany();
      allow create: if sameCompanyOnCreate();
      allow update: if sameCompany();
      allow delete: if sameCompany();
    }
    match /attendance_alerts/{document=**} {
      allow read, write: if signedIn();
    }
    match /attendance_logs/{document=**} {
      allow read, write: if signedIn();
    }

    // ── Requests ──────────────────────────────────────────────────────
    match /checkout_requests/{document=**} {
      allow read, write: if signedIn();
    }
    match /leave_requests/{document=**} {
      allow read, write: if signedIn();
    }
    match /permission_requests/{document=**} {
      allow read, write: if signedIn();
    }

    // ── Notifications ─────────────────────────────────────────────────
    match /notifications/{document=**} {
      allow read, write: if signedIn();
    }
    match /notification_actions/{document=**} {
      allow read, write: if signedIn();
    }
    match /event_dedupe/{document=**} {
      allow read, write: if signedIn();
    }

    // ── Metadata ──────────────────────────────────────────────────────
    match /staff_metadata/{document=**} {
      allow read, write: if signedIn();
    }

    // ── Workspace registry mirror ─────────────────────────────────────
    match /workspaces/{document=**} {
      allow read: if signedIn();
      allow write: if isCompanyAdmin();
    }

    // ── Catch-all deny ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}